{
  "name": "visiond-social-work-desktop",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-win.ps1",
    "installer:win": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.visiond.socialwork.desktop",
    "productName": "VisionD Social Work",
    "directories": { "output": "dist/installer" },
    "files": ["src/**/*", "package.json"],
    "win": { "target": "nsis", "signAndEditExecutable": false },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "artifactName": "VisionD-Social-Work-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "26.0.12"
  }
}
