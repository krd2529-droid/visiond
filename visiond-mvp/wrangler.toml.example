name = "visiond"
compatibility_date = "2026-08-01"
pages_build_output_dir = "public"

[[d1_databases]]
binding = "DB"
database_name = "visiond-db"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

[[d1_databases]]
binding = "ELON_WEB_DB"
database_name = "visiond-elon-web-db"
database_id = "REPLACE_WITH_ELON_WEB_D1_DATABASE_ID"

[[d1_databases]]
binding = "ELON_V7_DB"
database_name = "visiond-elon-v7-db"
database_id = "REPLACE_WITH_ELON_V7_D1_DATABASE_ID"

[[r2_buckets]]
binding = "FILES"
bucket_name = "visiond-files"

[[services]]
binding = "PORTRAIT_SANITIZER"
service = "visiond-live-portrait-sanitizer"

# Deploy the sibling workers/live-portrait-sanitizer Worker first. Pages does
# not support a direct [images] binding; this Service binding is the only
# supported portrait pixel-normalization path and upload fails closed without it.

[vars]
COMPANY_NAME = "VisionD Online"
OPENAI_MODEL = "gpt-4.1-mini"
BANK_NAME = "ตั้งค่าใน Cloudflare"
BANK_ACCOUNT_NAME = "ตั้งค่าใน Cloudflare"
BANK_ACCOUNT_NUMBER = "ตั้งค่าใน Cloudflare"
ADMIN_EMAIL = "admin@example.com"
TURNSTILE_SITE_KEY = ""
LIVE_CENTER_LOCAL_TEST_ENABLED = "1" # visibly labelled Boss/Admin simulator; never a platform event
# Live Center external integration contract (names only; never commit credential values):
# Secret: LIVE_CENTER_PROVIDER_ENCRYPTION_KEY (stable random key for private provider references)
# Secret: DID_BASIC_AUTHORIZATION (D-ID Basic authorization header)
# Vars: AZURE_SPEECH_RESOURCE_NAME and AZURE_SPEECH_VOICE (an allowlisted th-TH-* neural voice)
# Secret: AZURE_SPEECH_KEY
# Vars: FACEBOOK_PAGE_ID and FACEBOOK_APP_ID
# Secrets: FACEBOOK_PAGE_ACCESS_TOKEN, FACEBOOK_APP_SECRET and FACEBOOK_WEBHOOK_VERIFY_TOKEN
# D-ID Agent/WebRTC provisioning remains fail-closed until its authenticated contract and entitlement are verified.
ELON_MEMBER_DAILY_LIMIT = "100"
ELON_GLOBAL_DAILY_LIMIT = "1000"
PASSWORD_RESET_EMAIL_PROVIDER = "resend"
APP_ORIGIN = "https://visiondonline.com"
RESET_EMAIL_FROM = "VisionD <no-reply@example.com>"
# เพิ่ม TURNSTILE_SECRET_KEY เป็น Secret ใน Cloudflare ห้ามใส่คีย์จริงในไฟล์นี้
# เพิ่ม EASYSLIP_API_KEY เป็น Secret ใน Cloudflare ห้ามใส่คีย์จริงในไฟล์นี้
# เพิ่ม OPENAI_API_KEY เป็น Secret ใน Cloudflare ห้ามใส่คีย์จริงในไฟล์นี้
# หากไม่มี OpenAI ให้ใช้ GEMINI_API_KEY หรือ GEMINI_API_KEY_2 เป็น Secret (ELON จะเลือกตามลำดับนี้)
# ELON_GEMINI_MODEL = "gemini-2.5-flash" # ไม่ใส่ก็ใช้ค่านี้อัตโนมัติ
# เพิ่ม ELON_OPENAI_API_KEY หรือ ELON_GEMINI_API_KEY เป็น Secret แยกเฉพาะ ELON
# ระบบจะไม่ใช้ OPENAI_API_KEY/GEMINI_API_KEY ร่วมกับฟีเจอร์อื่นโดยอัตโนมัติ
# ELON_ALLOW_SHARED_PROVIDER_KEYS = "1" ใช้เฉพาะช่วงย้ายระบบชั่วคราว ไม่แนะนำ production
# เพิ่ม ELON_CLEANUP_TOKEN เป็น Secret แบบสุ่มอย่างน้อย 32 ตัวอักษร ห้ามใส่คีย์จริงในไฟล์นี้
# เพิ่ม ANALYTICS_CLEANUP_TOKEN เป็น Secret แบบสุ่มอย่างน้อย 32 ตัวอักษร สำหรับงานสรุป/ล้าง page views รายวัน
# เพิ่ม SEO_AUTOMATION_TOKEN เป็น Secret แบบสุ่มอย่างน้อย 32 ตัวอักษร และตั้งค่าเดียวกันใน visiond-maintenance Worker สำหรับสร้าง SEO วันละ 5 หน้า
# เพิ่ม VISION5_TOKEN_ENCRYPTION_KEY เป็น Secret แบบสุ่มอย่างน้อย 32 ตัวอักษร และห้ามเปลี่ยนหลังเริ่มใช้งาน
# เพิ่ม VISIOND_CHANNEL_ENCRYPTION_KEY เป็น Secret แบบสุ่มอย่างน้อย 32 ตัวอักษร สำหรับ LINE/Facebook V Easy และห้ามเปลี่ยนหลังเริ่มใช้งาน
# เพิ่ม TIKTOK_COMMISSION_COLLECTOR_SECRET เป็น Secret แบบสุ่มอย่างน้อย 32 ตัวอักษร ให้ตรงกับ Cloud Run collector
# Cloud Run collector ใช้ VISIOND_INGEST_URL, TIKTOK_COMMISSION_ACCOUNTS_JSON และ TIKTOK_COMMISSION_SOURCE_ADAPTER ตาม services/tiktok-commission-collector/env.example
# เพิ่ม RESEND_API_KEY เป็น Secret เพื่อเปิดระบบลืมรหัสผ่าน (ต้องยืนยันโดเมนผู้ส่งใน Resend)
