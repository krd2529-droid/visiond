name = "visiond-maintenance"
main = "src/index.js"
compatibility_date = "2026-08-10"

[triggers]
crons = ["17 18 * * *"] # 01:17 Asia/Bangkok, daily

[vars]
APP_ORIGIN = "https://visiondonline.com"

# Set secrets with Wrangler; never place their values in this file:
# Production deploys should use the sibling wrangler.toml, which contains no
# origin. Configure APP_ORIGIN and both tokens with `wrangler secret put` there.
